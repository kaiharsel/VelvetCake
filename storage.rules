rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /desserts/{allPaths=**} {
      // Product photos are public because the site has to render them.
      allow get: if true;

      // Only signed-in admins can list, upload, replace or delete CMS photos.
      allow list: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
