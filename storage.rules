rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Admin allowlist — same rationale as firestore.rules: a "signed-in" check
    // is not enough because anyone can self-register with the public API key.
    // Keep this UID list in sync with firestore.rules and replace the
    // placeholder before `firebase deploy`.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['sIiWqRaVAIfBsJ2ah41h5DEtbqo1'];
    }

    match /desserts/{allPaths=**} {
      // Product photos are public because the site has to render them.
      allow get: if true;

      // Only allowlisted admins can list, upload, replace or delete CMS photos.
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
